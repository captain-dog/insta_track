# Instagram account used to make API requests
IG_USERNAME=
# Value of the "sessionid" cookie from a logged-in browser (preferred auth)
IG_SESSION_ID=
# Optional "csrftoken" cookie; a random one is generated when empty
IG_CSRF_TOKEN=
# Fallback when IG_SESSION_ID is empty; often blocked by Instagram
IG_PASSWORD=
# Comma-separated accounts to track; defaults to IG_USERNAME
TRACK_USERNAMES=

TG_BOT_TOKEN=
TG_CHAT_ID=

# Optional, defaults to sqlite:///<project>/snapshots.db
# DATABASE_URL=
